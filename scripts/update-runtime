#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
readonly CPM_VERSION="v1.1.5"
readonly CPM_COMMIT="1e93312a5e801b1f3a27182309a8e62c16e9d7c5"
readonly CPM_URL="https://raw.githubusercontent.com/skaji/cpm/$CPM_COMMIT/cpm"
readonly CARTON_VERSION="v1.0.35"
readonly CARTON_URL="https://cpan.metacpan.org/authors/id/M/MI/MIYAGAWA/Carton-v1.0.35.tar.gz"
readonly CARTON_SHA256="9c4558ca97cd08b69fdfb52b28c3ddc2043ef52f0627b90e53d05a4087344175"

command -v cpanm >/dev/null 2>&1 || {
  printf 'scripts/update-runtime requires cpanm\n' >&2
  exit 1
}

temp_root="$(mktemp -d)"
trap 'rm -rf -- "$temp_root"' EXIT

curl --fail --location --proto '=https' --tlsv1.2 \
  --retry 3 --output "$temp_root/cpm" "$CPM_URL"
curl --fail --location --proto '=https' --tlsv1.2 \
  --retry 3 --output "$temp_root/carton.tar.gz" "$CARTON_URL"
cpm_sha256="$(
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$temp_root/cpm" | awk '{print $1}'
  else
    shasum -a 256 "$temp_root/cpm" | awk '{print $1}'
  fi
)"
carton_sha256="$(
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$temp_root/carton.tar.gz" | awk '{print $1}'
  else
    shasum -a 256 "$temp_root/carton.tar.gz" | awk '{print $1}'
  fi
)"
[[ "$carton_sha256" == "$CARTON_SHA256" ]] || {
  printf 'Carton tarball digest mismatch: expected %s, got %s\n' \
    "$CARTON_SHA256" "$carton_sha256" >&2
  exit 1
}

mkdir -p "$temp_root/carton"
cpanm --quiet --notest -L "$temp_root/carton" "$temp_root/carton.tar.gz"

mkdir -p "$temp_root/snapshot"
cp "$ROOT/runtime/cpanfile" "$temp_root/snapshot/cpanfile"
(
  cd "$temp_root/snapshot"
  PERL5LIB="$temp_root/carton/lib/perl5" \
    "$temp_root/carton/bin/carton" install --without develop --without test >/dev/null
)

rm -rf -- "$ROOT/runtime/lib/perl5"
mkdir -p "$ROOT/runtime/lib/perl5"
cp -R "$temp_root/carton/lib/perl5/." "$ROOT/runtime/lib/perl5/"
find "$ROOT/runtime/lib/perl5" -type d -name .meta -prune -exec rm -rf -- {} +
find "$ROOT/runtime/lib/perl5" -type f \( -name '.packlist' -o -name perllocal.pod \) -delete
find "$ROOT/runtime/lib/perl5" -type d -empty -delete
cp "$temp_root/cpm" "$ROOT/runtime/cpm"
cp "$temp_root/snapshot/cpanfile.snapshot" "$ROOT/runtime/cpanfile.snapshot"
chmod +x "$ROOT/runtime/cpm"
printf '%s  runtime/cpm\n' "$cpm_sha256" >"$ROOT/runtime/cpm.sha256"

tree_sha256="$("$ROOT/scripts/runtime-tree-digest")"
RUNTIME_CPM_VERSION="$CPM_VERSION" \
RUNTIME_CPM_COMMIT="$CPM_COMMIT" \
RUNTIME_CPM_URL="$CPM_URL" \
RUNTIME_CPM_SHA256="$cpm_sha256" \
RUNTIME_CARTON_VERSION="$CARTON_VERSION" \
RUNTIME_CARTON_SHA256="$CARTON_SHA256" \
RUNTIME_TREE_SHA256="$tree_sha256" \
perl -MJSON::PP -e '
  my ($path) = @ARGV;
  my $data = {
    cpm => {
      version => $ENV{RUNTIME_CPM_VERSION},
      commit => $ENV{RUNTIME_CPM_COMMIT},
      source => $ENV{RUNTIME_CPM_URL},
      sha256 => $ENV{RUNTIME_CPM_SHA256},
    },
    carton => {
      version => $ENV{RUNTIME_CARTON_VERSION},
      sha256 => $ENV{RUNTIME_CARTON_SHA256},
    },
    runtime_tree_sha256 => $ENV{RUNTIME_TREE_SHA256},
  };
  open my $fh, ">", $path or die "$path: $!";
  print {$fh} JSON::PP->new->canonical->pretty->encode($data);
' "$ROOT/runtime/manifest.json"

"$ROOT/scripts/check-runtime"
