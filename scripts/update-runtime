#!/usr/bin/env perl
use strict;
use warnings;
use FindBin;
use lib $FindBin::Bin;
use SetupMinil;
use File::Temp ();

my $manifest = decode_json(read_file("$SetupMinil::ROOT/runtime/manifest.json"));
my $work = File::Temp->newdir(CLEANUP => 1);
run('curl', '--fail', '--location', '--proto', '=https', '--tlsv1.2', '--retry', '3',
    '--output', "$work/cpm", $manifest->{cpm}{source});
write_file("$SetupMinil::ROOT/runtime/cpm", read_file("$work/cpm"));
chmod 0755, "$SetupMinil::ROOT/runtime/cpm" or die "chmod cpm: $!\n";
$manifest->{cpm}{sha256} = digest("$work/cpm");
write_file("$SetupMinil::ROOT/runtime/manifest.json", JSON::PP->new->canonical->pretty->encode($manifest));
run("$SetupMinil::ROOT/scripts/check-runtime");
