#!/usr/bin/env perl
use strict;
use warnings;
use FindBin;
use lib $FindBin::Bin;
use SetupMinil;

my $manifest = decode_json(read_file("$SetupMinil::ROOT/runtime/manifest.json"));
digest("$SetupMinil::ROOT/runtime/cpm") eq $manifest->{cpm}{sha256}
    or die "runtime/cpm digest mismatch\n";
read_file("$SetupMinil::ROOT/runtime/cpanfile") =~ /\Arequires 'Carton', '== v\d+\.\d+\.\d+';\n\z/
    or die "runtime/cpanfile must contain an exact Carton requirement\n";
!-e "$SetupMinil::ROOT/runtime/$_" or die "runtime/$_ must not be committed\n" for qw(lib cpanfile.snapshot);
run_quiet($SetupMinil::PERL, "$SetupMinil::ROOT/runtime/cpm", '--version');
