#!/usr/bin/env perl
use strict;
use warnings;

use Cwd ();
use File::Find ();
use File::Spec ();
use FindBin ();
use JSON::PP ();

my $repository = Cwd::abs_path(File::Spec->catdir($FindBin::Bin, '..'));
my $root = File::Spec->catdir($repository, 'snapshots');
sub safe_component {
    my ($value) = @_;
    $value = lc $value;
    $value =~ s/[^a-z0-9_.-]/_/g;
    return $value;
}

File::Find::find(
    {
        no_chdir => 1,
        wanted   => sub {
            return unless $_ eq File::Spec->catfile($File::Find::dir, 'environment.json');

            open my $fh, '<', $_ or die "$_: $!";
            my $environment = JSON::PP::decode_json(do { local $/; <$fh> });
            my @required = qw(
                runner_os
                runner_arch
                perl_version
                perl_archname
                minilla_version
            );
            for my $field (@required) {
                die "missing $field in $_\n"
                    unless defined $environment->{$field} && length $environment->{$field};
            }

            my $version = $environment->{minilla_version};
            die "invalid Minilla version in $_: $version\n"
                unless $version =~ /\Av\d+\.\d+\.\d+\z/;

            my $expected = join '-',
                safe_component($environment->{runner_os}),
                safe_component($environment->{runner_arch}),
                'perl',
                $environment->{perl_version},
                safe_component($environment->{perl_archname});
            my $relative = File::Spec->abs2rel($File::Find::dir, $root);
            $relative =~ s{\\}{/}g;
            die "snapshot path does not match its environment: $relative\n"
                unless $relative eq "$version/$expected";

            for my $file (qw(cpanfile cpanfile.snapshot)) {
                my $path = File::Spec->catfile($File::Find::dir, $file);
                -f $path or die "missing snapshot file: $path\n";
            }
        },
    },
    $root,
);
