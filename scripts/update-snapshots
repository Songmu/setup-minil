#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

version="${1:-}"
[[ -n "$version" ]] || {
  printf 'usage: scripts/update-snapshots <allowlisted-version>\n' >&2
  exit 1
}

manifest_values="$(perl -MJSON::PP -0777 -e '
  my ($file, $version) = @ARGV;
  open my $fh, "<", $file or die "$file: $!";
  my $data = decode_json(do { local $/; <$fh> });
  die "unsupported Minilla version: $version\n"
    unless exists $data->{versions}{$version};
  print join "\t", @{$data->{versions}{$version}}{
    qw(distribution_version download_url tarball_sha256)
  };
' "$ROOT/manifests/minilla.json" "$version")"
IFS=$'\t' read -r distribution_version download_url tarball_sha256 <<<"$manifest_values"

runner_os="${RUNNER_OS:-$(uname -s)}"
case "$runner_os" in
  Darwin) runner_os=macOS ;;
esac
runner_arch="${RUNNER_ARCH:-$(uname -m)}"
case "$runner_arch" in
  x86_64|amd64) runner_arch=X64 ;;
  arm64|aarch64) runner_arch=ARM64 ;;
esac
perl_version="$(perl -MConfig -e 'print $Config{version}')"
perl_archname="$(perl -MConfig -e 'print $Config{archname}')"
safe_archname="$(printf '%s' "$perl_archname" | tr '[:upper:]' '[:lower:]' | tr -c 'A-Za-z0-9_.-' '_')"
directory="$version/$(printf '%s-%s-perl-%s-%s' \
  "$runner_os" "$runner_arch" "$perl_version" "$safe_archname" |
  tr '[:upper:]' '[:lower:]')"
destination="$ROOT/snapshots/$directory"

temp_root="$(mktemp -d)"
trap 'rm -rf -- "$temp_root"' EXIT

tarball="$temp_root/Minilla-$version.tar.gz"
curl --fail --location --proto '=https' --tlsv1.2 \
  --retry 3 --output "$tarball" "$download_url"
perl -MDigest::SHA -e '
  my ($file, $expected) = @ARGV;
  open my $fh, "<", $file or die "$file: $!";
  binmode $fh;
  my $actual = Digest::SHA->new(256)->addfile($fh)->hexdigest;
  die "Minilla tarball SHA-256 mismatch: expected $expected, got $actual\n"
    unless $actual eq $expected;
' "$tarball" "$tarball_sha256"
tar -xOf "$tarball" "Minilla-$version/META.json" >"$temp_root/META.json"

if ! command -v carmel >/dev/null 2>&1; then
  carmel_root="$temp_root/carmel"
  perl "$ROOT/runtime/cpm" install \
    --mirror=https://cpan.metacpan.org/ \
    "--local-lib-contained=$carmel_root" \
    --exclude-vendor \
    "--home=$temp_root/carmel-cpm-home" \
    --no-prebuilt \
    --no-test \
    Carmel
  export PATH="$carmel_root/bin:$PATH"
  export PERL5LIB="$carmel_root/lib/perl5${PERL5LIB:+:$PERL5LIB}"
fi

perl -MCPAN::Meta -e '
  my ($meta_file, $version, $cpanfile) = @ARGV;
  my $meta = CPAN::Meta->load_file($meta_file);
  my $recommends = $meta->effective_prereqs
    ->requirements_for("runtime", "recommends")->as_string_hash;
  open my $fh, ">", $cpanfile or die "$cpanfile: $!";
  printf {$fh} "requires \x27Minilla\x27, \x27== %s\x27;\n", $version;
  for my $module (sort keys %$recommends) {
    printf {$fh} "requires \x27%s\x27, \x27%s\x27;\n", $module, $recommends->{$module};
  }
' "$temp_root/META.json" "$distribution_version" "$temp_root/cpanfile"
(
  cd "$temp_root"
  carmel install
)
[[ -f "$temp_root/cpanfile.snapshot" ]] || {
  printf 'Carmel did not produce cpanfile.snapshot\n' >&2
  exit 1
}

rm -rf -- "$destination"
mkdir -p "$destination"
cp "$temp_root/cpanfile" "$destination/cpanfile"
cp "$temp_root/cpanfile.snapshot" "$destination/cpanfile.snapshot"
CARMEL_VERSION="$(carmel version 2>/dev/null || carmel --version)" \
RUNNER_OS_VALUE="$runner_os" \
RUNNER_ARCH_VALUE="$runner_arch" \
PERL_VERSION_VALUE="$perl_version" \
PERL_ARCHNAME_VALUE="$perl_archname" \
MINILLA_VERSION_VALUE="$version" \
perl -MJSON::PP -e '
  my ($path) = @ARGV;
  my $data = {
    runner_os => $ENV{RUNNER_OS_VALUE},
    runner_arch => $ENV{RUNNER_ARCH_VALUE},
    perl_version => $ENV{PERL_VERSION_VALUE},
    perl_archname => $ENV{PERL_ARCHNAME_VALUE},
    minilla_version => $ENV{MINILLA_VERSION_VALUE},
    generator => { carmel_version => $ENV{CARMEL_VERSION} },
  };
  open my $fh, ">", $path or die "$path: $!";
  print {$fh} JSON::PP->new->canonical->pretty->encode($data);
' "$destination/environment.json"

"$ROOT/scripts/check-snapshots"

if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
  printf 'snapshot-path=%s\n' "$directory" >>"$GITHUB_OUTPUT"
else
  printf '%s\n' "$directory"
fi
